+// Consumes input up to and including the next '>'.  Returns false at EOF.
+bool readSeqFile::skip_to_header(){
+    for(;;){
+        if(bpos >= blen && !fill()) return false;
+        void* gt = memchr(&buf[bpos], '>', blen - bpos);
+        if(gt != NULL){
+            bpos = (size_t)((char*)gt - &buf[0]) + 1;
+            return true;
+        }
+        bpos = blen;
+    }
+}
