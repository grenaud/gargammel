+// One point of a cumulative quality-score distribution.
+struct qualPoint{
+    unsigned int cum;
+    unsigned short qual;
+};
+
+/*
+ * Drawing one quality score per base is the hottest loop in ART: a 150bp
+ * paired-end run does two lookups per base.  The distributions themselves are
+ * built into std::map (which gives sorting and de-duplication for free) and
+ * then flattened here.
+ *
+ * The lookup answers "first breakpoint with cum >= cc", exactly what
+ * map::lower_bound returned.  Searching for it -- by tree walk or by binary
+ * search -- costs a handful of unpredictable branches per base.  Instead the
+ * [0, max_dist_number] range is cut into fixed 1024-wide buckets: a bucket
+ * whose two ends resolve to the same breakpoint resolves to that breakpoint
+ * throughout (the answer is monotone in cc), so its score can be read straight
+ * out of a byte table.  Only buckets straddling a breakpoint need a scan, and
+ * a profile has a few dozen breakpoints against ~1000 buckets.
+ */
+#define QUAL_LUT_SHIFT 10
+#define QUAL_LUT_NONE  255   // bucket straddles a breakpoint: scan `pts`
+
+struct qualDist{
+    vector<qualPoint> pts;        // exact, sorted breakpoints
+    vector<unsigned char> lut;    // per-bucket answer, or QUAL_LUT_NONE
+};
+typedef vector<qualDist> qualDistVec;
+
+// Linear fallback: branchless, and the arrays are only tens of entries long.
+inline unsigned short qual_scan(const vector<qualPoint>& v, unsigned int cc){
+    size_t idx=0, n=v.size();
+    for(size_t k=0; k<n; k++) idx += (v[k].cum < cc);
+    // The last key is the distribution maximum, so idx is in range; the clamp
+    // only guards against rounding in a malformed profile.
+    if(idx>=n) idx=n-1;
+    return v[idx].qual;
+};
+
+inline unsigned short qual_lookup(const qualDist& d, unsigned int cc){
+    unsigned char q=d.lut[cc>>QUAL_LUT_SHIFT];
+    if(q!=QUAL_LUT_NONE) return q;
+    return qual_scan(d.pts, cc);
 };
 
