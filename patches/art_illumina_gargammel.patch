diff -ruN a/art_illumina_src/artio.cpp b/art_illumina_src/artio.cpp
--- a/art_illumina_src/artio.cpp	1970-01-01 00:00:00.000000000 +0000
+++ b/art_illumina_src/artio.cpp	2026-08-17 19:59:11.040129742 +0000
@@ -0,0 +1,184 @@
+/*
+ * artio.cpp -- see artio.h
+ */
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstddef>
+#include <cerrno>
+#include <iostream>
+#include <unistd.h>
+#include <fcntl.h>
+
+#include "artio.h"
+
+// Buffer big enough that whole FASTQ records are batched into few syscalls.
+static const size_t ART_IO_BUFSIZE = 256 * 1024;
+
+// Parses the descriptor spellings documented in artio.h.  Returns the raw
+// descriptor number, or -1 when `spec` is an ordinary path.
+static int parse_fd_spec(const char* spec, bool for_write) {
+    if (spec == NULL || spec[0] == '\0') return -1;
+
+    if (strcmp(spec, "-") == 0) return for_write ? 1 : 0;
+    if (strcmp(spec, "/dev/stdin") == 0) return 0;
+    if (strcmp(spec, "/dev/stdout") == 0) return 1;
+    if (strcmp(spec, "/dev/stderr") == 0) return 2;
+
+    const char* num = NULL;
+    if (strncmp(spec, "fd:", 3) == 0) num = spec + 3;
+    else if (strncmp(spec, "/dev/fd/", 8) == 0) num = spec + 8;
+    else if (strncmp(spec, "/proc/self/fd/", 14) == 0) num = spec + 14;
+    if (num == NULL || *num == '\0') return -1;
+
+    char* endp = NULL;
+    long v = strtol(num, &endp, 10);
+    if (endp == num || *endp != '\0' || v < 0 || v > 1000000) return -1;
+    return (int)v;
+}
+
+int art_fd_spec_number(const char* spec, bool for_write) {
+    return parse_fd_spec(spec, for_write);
+}
+
+bool art_is_fd_spec(const char* spec, bool for_write) {
+    return parse_fd_spec(spec, for_write) >= 0;
+}
+
+int art_resolve_fd(const char* spec, bool for_write) {
+    int fd = parse_fd_spec(spec, for_write);
+    if (fd < 0) return -1;
+    // Duplicate so that closing our handle leaves the caller's fd alone.
+    int dup_fd = dup(fd);
+    if (dup_fd < 0) {
+        cerr << "Fatal Error: cannot use file descriptor " << fd << ": " << strerror(errno) << endl;
+        exit(1);
+    }
+    return dup_fd;
+}
+
+bool art_has_gz_suffix(const string& path) {
+    return path.size() > 3 && path.compare(path.size() - 3, 3, ".gz") == 0;
+}
+
+gzFile art_gzopen_read(const char* spec) {
+    int fd = art_resolve_fd(spec, false);
+    if (fd >= 0) return gzdopen(fd, "rb");
+    return gzopen(spec, "rb");
+}
+
+ArtOutBuf::ArtOutBuf()
+    : buf_(NULL), bufsize_(ART_IO_BUFSIZE), fd_(-1), gz_(NULL), failed_(false) {
+    buf_ = new char[bufsize_];
+    setp(buf_, buf_ + bufsize_ - 1);
+}
+
+ArtOutBuf::~ArtOutBuf() {
+    close();
+    delete[] buf_;
+}
+
+bool ArtOutBuf::open(const char* spec, bool compress, int level) {
+    close();
+    failed_ = false;
+
+    if (!compress && art_has_gz_suffix(spec)) compress = true;
+    if (level < 1) level = 1;
+    if (level > 9) level = 9;
+
+    int fd = art_resolve_fd(spec, true);
+
+    if (compress) {
+        char mode[8];
+        snprintf(mode, sizeof(mode), "wb%d", level);
+        gz_ = (fd >= 0) ? gzdopen(fd, mode) : gzopen(spec, mode);
+        if (gz_ == NULL) {
+            if (fd >= 0) ::close(fd);
+            return false;
+        }
+        // zlib's own buffer on top of ours; larger chunks compress faster.
+        gzbuffer(gz_, 128 * 1024);
+        return true;
+    }
+
+    if (fd < 0) {
+        fd = ::open(spec, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+        if (fd < 0) return false;
+    }
+    fd_ = fd;
+    return true;
+}
+
+void ArtOutBuf::close() {
+    if (!is_open()) return;
+    flush_buffer();
+    if (gz_ != NULL) {
+        gzclose(gz_);
+        gz_ = NULL;
+    }
+    if (fd_ >= 0) {
+        ::close(fd_);
+        fd_ = -1;
+    }
+}
+
+bool ArtOutBuf::raw_write(const char* data, size_t n) {
+    if (n == 0) return true;
+    if (failed_) return false;
+
+    if (gz_ != NULL) {
+        // gzwrite takes an unsigned int; our buffer is far below that limit.
+        if (gzwrite(gz_, data, (unsigned)n) != (int)n) {
+            failed_ = true;
+            return false;
+        }
+        return true;
+    }
+
+    size_t off = 0;
+    while (off < n) {
+        ssize_t w = ::write(fd_, data + off, n - off);
+        if (w < 0) {
+            if (errno == EINTR) continue;
+            failed_ = true;
+            return false;
+        }
+        off += (size_t)w;
+    }
+    return true;
+}
+
+bool ArtOutBuf::flush_buffer() {
+    ptrdiff_t n = pptr() - pbase();
+    if (n <= 0) return true;
+    bool ok = raw_write(pbase(), (size_t)n);
+    setp(buf_, buf_ + bufsize_ - 1);
+    return ok;
+}
+
+int ArtOutBuf::overflow(int c) {
+    if (c != EOF) {
+        *pptr() = (char)c;
+        pbump(1);
+    }
+    return flush_buffer() ? c : EOF;
+}
+
+// Bypasses the buffer for large blocks so long sequences are not copied twice.
+streamsize ArtOutBuf::xsputn(const char* s, streamsize n) {
+    if (n <= 0) return 0;
+    if ((size_t)n < bufsize_ / 2) {
+        streamsize room = epptr() - pptr();
+        if (n > room && !flush_buffer()) return 0;
+        memcpy(pptr(), s, (size_t)n);
+        pbump((int)n);
+        return n;
+    }
+    if (!flush_buffer()) return 0;
+    return raw_write(s, (size_t)n) ? n : 0;
+}
+
+int ArtOutBuf::sync() {
+    return flush_buffer() ? 0 : -1;
+}
diff -ruN a/art_illumina_src/artio.h b/art_illumina_src/artio.h
--- a/art_illumina_src/artio.h	1970-01-01 00:00:00.000000000 +0000
+++ b/art_illumina_src/artio.h	2026-08-17 19:59:11.040129742 +0000
@@ -0,0 +1,96 @@
+/*
+ * artio.h -- I/O helpers for ART: transparent gzip, and stdin/stdout/file
+ * descriptor targets so art_illumina can sit in the middle of a pipeline.
+ *
+ * Both readers and writers accept, in place of an ordinary path:
+ *
+ *   "-"            stdin for input, stdout for output
+ *   "/dev/stdin", "/dev/stdout", "/dev/stderr"
+ *   "/dev/fd/N"    file descriptor N
+ *   "fd:N"         file descriptor N (portable spelling of the above)
+ *
+ * Input is decompressed transparently: zlib's gzread() passes uncompressed
+ * data through untouched, so a plain and a gzipped FASTA are handled by the
+ * same code path with no sniffing on our side.
+ *
+ * Output is compressed when the caller asks for it, or automatically when the
+ * destination path ends in ".gz".
+ */
+
+#pragma once
+
+#include <zlib.h>
+#include <ostream>
+#include <streambuf>
+#include <string>
+
+using namespace std;
+
+// The descriptor `spec` refers to, or -1 when `spec` is an ordinary path.
+int art_fd_spec_number(const char* spec, bool for_write);
+
+// True when `spec` names a file descriptor rather than an ordinary path.
+bool art_is_fd_spec(const char* spec, bool for_write);
+
+// If `spec` names a file descriptor rather than a path, returns a *duplicate*
+// of that descriptor (so closing it later never clobbers the caller's).
+// Returns -1 when `spec` is an ordinary path.
+int art_resolve_fd(const char* spec, bool for_write);
+
+// True when the destination should be gzip-compressed based on its name.
+bool art_has_gz_suffix(const string& path);
+
+// Opens `spec` for reading, transparently handling gzip, plain files, and the
+// descriptor spellings above. Returns NULL on failure.
+gzFile art_gzopen_read(const char* spec);
+
+/*
+ * A streambuf that writes to either a raw file descriptor or a gzFile, with a
+ * large buffer so a run does not turn into one write() per line.  Presented as
+ * a std::ostream so all the existing `<<` code keeps working unchanged.
+ */
+class ArtOutBuf : public streambuf {
+public:
+    ArtOutBuf();
+    ~ArtOutBuf();
+
+    // `compress` forces gzip; otherwise it is inferred from a ".gz" suffix.
+    // Returns false if the destination could not be opened.
+    bool open(const char* spec, bool compress, int level);
+    bool is_open() const { return fd_ >= 0 || gz_ != NULL; }
+    void close();
+
+protected:
+    virtual int overflow(int c);
+    virtual streamsize xsputn(const char* s, streamsize n);
+    virtual int sync();
+
+private:
+    bool flush_buffer();
+    bool raw_write(const char* data, size_t n);
+
+    char* buf_;
+    size_t bufsize_;
+    int fd_;
+    gzFile gz_;
+    bool failed_;
+};
+
+class ArtOStream : public ostream {
+public:
+    ArtOStream() : ostream(&buf_) {}
+    ~ArtOStream() { close(); }
+
+    bool open(const string& spec, bool compress = false, int level = 6) {
+        if (!buf_.open(spec.c_str(), compress, level)) {
+            setstate(ios::failbit);
+            return false;
+        }
+        return true;
+    }
+    bool is_open() const { return buf_.is_open(); }
+    void close() { flush(); buf_.close(); }
+
+private:
+    ArtOutBuf buf_;
+};
diff -ruN a/art_illumina_src/artrand.h b/art_illumina_src/artrand.h
--- a/art_illumina_src/artrand.h	1970-01-01 00:00:00.000000000 +0000
+++ b/art_illumina_src/artrand.h	2026-08-17 19:59:11.040129742 +0000
@@ -0,0 +1,90 @@
+/*
+ * artrand.h -- reproducible replacement for srand()/rand() in ART.
+ *
+ * ART draws every random number through r_prob() == rand()/(double)RAND_MAX.
+ * Relying on the C library has two problems for a simulator:
+ *
+ *   1) rand() is only reproducible within one libc.  The same seed gives
+ *      different reads on glibc and on macOS, so a "fixed seed" run is not
+ *      actually reproducible across machines.
+ *   2) glibc's rand() takes an internal lock on every call, which is pure
+ *      overhead here and shows up in profiles.
+ *
+ * This header reimplements glibc's TYPE_3 random() (the additive-feedback
+ * generator behind rand() on Linux) as a header-only, lock-free generator.
+ * It produces bit-identical output to glibc rand() for any seed, so results
+ * from the stock ART are preserved, while also making runs reproducible on
+ * platforms whose libc uses a different algorithm.
+ *
+ * Algorithm (glibc stdlib/random_r.c, TYPE_3: DEG=31, SEP=3):
+ *   state r[0..30] seeded with the minimal-standard LCG 16807 (Schrage's
+ *   method), front tap at index 3, rear tap at index 0, then repeatedly
+ *   r[f] += r[rear]; output = (uint32_t)r[f] >> 1.  The first 310 outputs
+ *   are discarded.
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#define ART_RAND_MAX 2147483647
+
+namespace artrand_detail {
+    // Function-local statics keep this header-only, with no .cpp to link and
+    // no duplicate-symbol problems across translation units.
+    struct State {
+        int32_t r[31];
+        int f;     // front tap (i-3)
+        int rear;  // rear tap  (i-31)
+    };
+    inline State& state() {
+        static State s;
+        return s;
+    }
+}
+
+// Equivalent to glibc rand(): returns a value in [0, ART_RAND_MAX].
+inline int art_rand() {
+    artrand_detail::State& s = artrand_detail::state();
+    s.r[s.f] = (int32_t)((uint32_t)s.r[s.f] + (uint32_t)s.r[s.rear]);
+    int result = (int)((uint32_t)s.r[s.f] >> 1);
+    if (++s.f >= 31) s.f = 0;
+    if (++s.rear >= 31) s.rear = 0;
+    return result;
+}
+
+// Matches glibc srand(): a zero seed behaves like a seed of 1.
+inline void art_srand(unsigned int seed) {
+    artrand_detail::State& s = artrand_detail::state();
+    s.r[0] = (seed == 0) ? 1 : (int32_t)seed;
+    for (int i = 1; i < 31; i++) {
+        // r[i] = (16807 * r[i-1]) % 2147483647, computed without overflow
+        // exactly as glibc does it.
+        int32_t prev = s.r[i - 1];
+        int32_t hi = prev / 127773;
+        int32_t lo = prev % 127773;
+        int32_t word = 16807 * lo - 2836 * hi;
+        if (word < 0) word += 2147483647;
+        s.r[i] = word;
+    }
+    s.f = 3;
+    s.rear = 0;
+    for (int i = 0; i < 310; i++) art_rand();
+}
+
+/*
+ * floor() and ceil() are ordinary libm calls on baseline x86-64, because the
+ * single-instruction form (roundsd) needs SSE4.1 and is not in the default
+ * target.  ART puts one of them on the result of nearly every random draw, so
+ * the call overhead is significant.  For non-negative arguments these are
+ * exactly equivalent -- truncation toward zero is floor -- and compile to a
+ * couple of instructions.  Do not use them where the argument can be negative.
+ */
+inline double art_floor_nonneg(double v) {
+    return (double)(long long)v;
+}
+
+inline double art_ceil_nonneg(double v) {
+    long long t = (long long)v;
+    return (v > (double)t) ? (double)(t + 1) : (double)t;
+}
