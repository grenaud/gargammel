 using namespace std;
 
+// Byte tables replacing the per-base toupper() call and switch in ini_set().
+// ini_set() runs once per input record, so on the millions of short amplicons
+// gargammel feeds ART this loop is a large fraction of the total run time.
+struct artBaseTables{
+    char up[256];
+    char cmp[256];
+    artBaseTables(){
+        for(int i=0; i<256; i++){
+            char u=(char)i;
+            if(i>='a' && i<='z') u=(char)(i-'a'+'A');
+            up[i]=u;
+            switch(u){
+                case 'A': cmp[i]='T'; break;
+                case 'C': cmp[i]='G'; break;
+                case 'G': cmp[i]='C'; break;
+                case 'T': cmp[i]='A'; break;
+                default:  cmp[i]='N';
+            }
+        }
+    }
+};
+inline const artBaseTables& art_base_tables(){
+    static const artBaseTables t;
+    return t;
+}
