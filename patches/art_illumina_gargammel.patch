+bool readSeqFile::fill(){
+    if(at_eof) return false;
+    int n = gzread(fp, &buf[0], (unsigned)buf.size());
+    if(n <= 0){
+        at_eof = true;
+        blen = 0;
+        bpos = 0;
+        return false;
+    }
+    blen = (size_t)n;
+    bpos = 0;
+    return true;
