+bool readSeqFile::read_line(string& line){
+    line.clear();
+    bool got_any = false;
+    for(;;){
+        if(bpos >= blen && !fill()) return got_any;
+        got_any = true;
+        // Copy the whole run up to the newline in one go.
+        void* nl = memchr(&buf[bpos], '\n', blen - bpos);
+        if(nl != NULL){
+            size_t idx = (size_t)((char*)nl - &buf[0]);
+            line.append(&buf[bpos], idx - bpos);
+            bpos = idx + 1;
+            return true;
+        }
+        line.append(&buf[bpos], blen - bpos);
+        bpos = blen;
     }
