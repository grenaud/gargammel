+// True when this output target is stdout (any of "-", "/dev/stdout", "fd:1").
+static bool is_stdout_target(const string& path){
+    return art_fd_spec_number(path.c_str(), true)==1;
+}
+
+// Equivalent to `istringstream(s) >> s`: keep the first whitespace-delimited
+// token.  Doing it in place avoids constructing a stringstream per input
+// record, which is a measurable cost on millions of short amplicons.
+static inline void keep_first_token(string& s){
+    static const char* WS=" \t\n\v\f\r";
+    size_t b=s.find_first_not_of(WS);
+    if(b==string::npos){ s.clear(); return; }
+    size_t e=s.find_first_of(WS, b);
+    if(e!=string::npos) s.erase(e);
+    s.erase(0, b);
+}
+
+static inline void append_long(string& s, long v){
+    char b[24];
+    int n=snprintf(b, sizeof(b), "%ld", v);
+    s.append(b, n);
+}
+
+// Serialises one FASTQ record into `out`.  Building the whole record and
+// handing it to the stream once replaces roughly one operator<< per base.
+static inline void format_fastq(string& out, const string& name, const string& seq,
+                                const vector<short>& qual){
+    out.clear();
+    out+='@'; out+=name; out+='\n';
+    out+=seq; out+="\n+\n";
+    size_t base=out.size();
+    out.resize(base+qual.size()+1);
+    for(size_t k=0; k<qual.size(); k++){
+        out[base+k]=(char)(qual[k]+33);
+    }
+    out[base+qual.size()]='\n';
+}
 
